PORT=3000
HOST=0.0.0.0
# Compatible chat completions endpoint, including /v1 where required.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional image-to-image via multimodal chat completions. Separate from text AI.
IMAGE_BASE_URL=https://cpa.jajaicb.cn/v1
IMAGE_API_KEY=
IMAGE_MODEL=gemini-3.1-flash-image

# Optional two-reference virtual-travel editing models. Keys stay server-side.
# BASE_URL defaults to IMAGE_BASE_URL; no implicit cross-model/key fallback.
TRAVEL_IMAGE2_BASE_URL=https://cpa.jajaicb.cn/v1
TRAVEL_IMAGE2_API_KEY=
TRAVEL_IMAGE25_BASE_URL=https://cpa.jajaicb.cn/v1
TRAVEL_IMAGE25_API_KEY=
TRAVEL_DEFAULT_ENGINE=gemini

# Bounded multi-visitor queue and per-process hourly request caps (not prices).
IMAGE_CONCURRENCY=2
IMAGE_MAX_CALLS_PER_HOUR=100
STORY_MAX_CALLS_PER_HOUR=120
# Enable only behind a local proxy that overwrites X-Real-IP / X-Forwarded-Proto.
TRUST_LOCAL_PROXY=false
